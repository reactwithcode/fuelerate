<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;700&display=swap">

{{ 'section-interactive-benefit-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'benefit-showcase.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
    --ibs-image-col-width: {{ section.settings.image_width }}%;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign has_images = false
  for block in section.blocks
    if block.settings.category_image != blank
      assign has_images = true
      break
    endif
  endfor
-%}

<benefit-showcase>
  <div class="ibs section-{{ section.id }}-padding{% unless has_images %} ibs--no-images{% endunless %}">

    {%- comment -%} Left column — heading, subtext, pill list {%- endcomment -%}
    <div class="ibs__left">
      {%- if section.settings.heading != blank -%}
        <h2 class="ibs__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="ibs__subtext">{{ section.settings.subtext | escape }}</p>
      {%- endif -%}

      <ul class="ibs__list" role="tablist" aria-label="{{ section.settings.heading | default: 'Benefit categories' | escape }}">
        {%- for block in section.blocks -%}
          <li class="ibs__item" role="presentation" {{ block.shopify_attributes }}>

            <button
              class="ibs__pill{% if forloop.first %} ibs__pill--active{% endif %}"
              data-index="{{ forloop.index0 }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              type="button"
            >
              {%- if block.settings.icon != blank -%}
                <img
                  src="{{ block.settings.icon | image_url: width: 48 }}"
                  alt=""
                  class="ibs__pill-icon"
                  loading="lazy"
                  width="24"
                  height="24"
                  aria-hidden="true"
                >
              {%- endif -%}
              <span class="ibs__pill-label">{{ block.settings.title | default: 'Benefit' | escape }}</span>
            </button>

            {%- comment -%} Mobile inline detail card {%- endcomment -%}
            <div
              class="ibs__mobile-card{% if forloop.first %} ibs__mobile-card--active{% endif %}"
              data-index="{{ forloop.index0 }}"
              role="tabpanel"
            >
              <h3 class="ibs__panel-title">{{ block.settings.title | default: 'Benefit' | escape }}</h3>
              {%- if block.settings.description != blank -%}
                <p class="ibs__panel-description">{{ block.settings.description | escape }}</p>
              {%- endif -%}
              {%- if block.settings.bullets != blank -%}
                {%- assign bullet_lines = block.settings.bullets | newline_to_br | split: '<br />' -%}
                <ul class="ibs__bullets">
                  {%- for bullet in bullet_lines -%}
                    {%- assign b = bullet | strip -%}
                    {%- if b != blank -%}
                      <li>{{ b | escape }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.cta_url != blank -%}
                <a class="ibs__cta-area" href="{{ block.settings.cta_url }}">
                  <svg class="ibs__cta-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M9 3v10.5l-3 5.5a2.5 2.5 0 0 0 2.1 3.5h9.8a2.5 2.5 0 0 0 2.1-3.5L15 13.5V3"/><path d="M9 16.5h6"/></svg>
                  <span class="ibs__cta-text">{{ block.settings.cta_text | default: 'Explore the science behind these benefits' | escape }}</span>
                </a>
              {%- endif -%}
            </div>

          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- comment -%} Centre column — category images + prev arrow {%- endcomment -%}
    <div class="ibs__image-col">
      {%- for block in section.blocks -%}
        {%- if block.settings.category_image != blank -%}
          <img
            src="{{ block.settings.category_image | image_url: width: 800 }}"
            srcset="{{ block.settings.category_image | image_url: width: 400 }} 400w, {{ block.settings.category_image | image_url: width: 600 }} 600w, {{ block.settings.category_image | image_url: width: 800 }} 800w"
            sizes="(min-width: 990px) var(--ibs-image-col-width, 35vw), 100vw"
            class="ibs__image{% if forloop.first %} ibs__image--active{% endif %}"
            data-index="{{ forloop.index0 }}"
            alt="{{ block.settings.title | escape }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            width="{{ block.settings.category_image.width }}"
            height="{{ block.settings.category_image.height }}"
          >
        {%- endif -%}
      {%- endfor -%}
      {%- if section.blocks.size > 1 -%}
        <button class="ibs__arrow ibs__arrow--prev" aria-label="Previous benefit" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </button>
      {%- endif -%}
    </div>

    {%- comment -%} Right column — dark detail panel + next arrow {%- endcomment -%}
    <div class="ibs__panel">
      {%- for block in section.blocks -%}
        <div
          class="ibs__panel-content{% if forloop.first %} ibs__panel-content--active{% endif %}"
          data-index="{{ forloop.index0 }}"
          role="tabpanel"
        >
          <h3 class="ibs__panel-title">{{ block.settings.title | default: 'Benefit' | escape }}</h3>
          {%- if block.settings.description != blank -%}
            <p class="ibs__panel-description">{{ block.settings.description | escape }}</p>
          {%- endif -%}
          {%- if block.settings.bullets != blank -%}
            {%- assign bullet_lines = block.settings.bullets | newline_to_br | split: '<br />' -%}
            <ul class="ibs__bullets">
              {%- for bullet in bullet_lines -%}
                {%- assign b = bullet | strip -%}
                {%- if b != blank -%}
                  <li>{{ b | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if block.settings.cta_url != blank -%}
            <a class="ibs__cta-area" href="{{ block.settings.cta_url }}">
              <svg class="ibs__cta-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M9 3v10.5l-3 5.5a2.5 2.5 0 0 0 2.1 3.5h9.8a2.5 2.5 0 0 0 2.1-3.5L15 13.5V3"/><path d="M9 16.5h6"/></svg>
              <span class="ibs__cta-text">{{ block.settings.cta_text | default: 'Explore the science behind these benefits' | escape }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- if section.blocks.size > 1 -%}
        <button class="ibs__arrow ibs__arrow--next" aria-label="Next benefit" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </button>
      {%- endif -%}
    </div>

  </div>
</benefit-showcase>

{% schema %}
{
  "name": "Benefit Showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "One Natural Solution. Whole-Body Benefits."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Section subtext",
      "default": "Grounding supports every major system in your body, helping relieve chronic symptoms, restore balance, and promote long-term wellness. Backed by 20+ years of research and thousands of customer results."
    },
    {
      "type": "header",
      "content": "Image column"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image column width",
      "min": 20,
      "max": 55,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit category",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Pill icon",
          "info": "Small icon shown inside the pill. Recommended: 48×48px, dark on transparent background."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "Benefit Category"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Describe the benefit category here."
        },
        {
          "type": "textarea",
          "id": "bullets",
          "label": "Bullet points",
          "info": "One bullet per line.",
          "default": "Key benefit one\nKey benefit two\nKey benefit three"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Link text",
          "default": "Explore the science behind these benefits"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Link URL",
          "info": "Leave blank to hide the link."
        },
        {
          "type": "image_picker",
          "id": "category_image",
          "label": "Category image",
          "info": "Shown in the centre column when this benefit is active."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefit Showcase",
      "blocks": [
        {
          "type": "benefit",
          "settings": { "title": "Neurological & Mental Health" }
        },
        {
          "type": "benefit",
          "settings": { "title": "Musculoskeletal Pain & Inflammation" }
        },
        {
          "type": "benefit",
          "settings": { "title": "Cardiovascular & Circulatory Health" }
        },
        {
          "type": "benefit",
          "settings": { "title": "Immune & Inflammatory Conditions" }
        },
        {
          "type": "benefit",
          "settings": { "title": "Hormonal & Metabolic Balance" }
        },
        {
          "type": "benefit",
          "settings": { "title": "Specialized Support" }
        }
      ]
    }
  ]
}
{% endschema %}
