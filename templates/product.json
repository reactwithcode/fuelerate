        "tab_NPiVA6": {
          "type": "tab",
          "settings": {
            "label": "Who is it for?",
            "content": "<p>Grounding can support you if you’re:<br/></p><ul><li>Struggling with poor sleep, racing thoughts, or insomnia</li><li>Waking up stiff, sore, or fatigued</li><li>Living with chronic pain, inflammation, or autoimmune issues</li><li>Experiencing anxiety, stress, or hormonal imbalance</li><li>Looking for a natural, non-invasive wellness solution</li></ul>"
